# Band endpoints (defaults are fine for app.band.ai)
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket
# Narration model: ollama (local, default) or gemini
LLM_BACKEND=ollama
OLLAMA_MODEL=gemma4:e4b
OLLAMA_BASE_URL=http://localhost:11434
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_API_KEY=
# NARRATE=0          skip LLM narration (templates only)
# LYZR_OFFLINE=1     use cached Lyzr verdicts only
